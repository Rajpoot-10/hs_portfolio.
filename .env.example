# Server-only. Copy to .env.local and replace values; never use VITE_ prefixes.
GEMINI_API_KEY=your_gemini_key
PINECONE_API_KEY=your_pinecone_key
PINECONE_INDEX_NAME=portfolio-hassam
PINECONE_NAMESPACE=portfolio

# Create a serverless Pinecone dense index: cosine, dimension 768.
# Changing embedding model or dimension requires full re-ingestion.
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSION=768
GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite
RAG_TOP_K=5
# Optional cosine threshold: leave unset until calibrated with eval:rag.
# RAG_MIN_SCORE=
# Development console only; never enabled in production.
RAG_DEBUG=false
